{
  "name": "temporis-reader",
  "version": "0.8.1",
  "description": "Capacitor hello world with file reading",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync": "npm run build && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc",
    "apk:release": "npm run sync && cd android && ./gradlew assembleRelease",
    "icons": "node scripts/generate-icons.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
